# Copy this file to ".env" and change EVERY password before the first start.
# Passwords: at least 12 characters, with upper case, lower case, a number and a symbol.
# Do NOT use these characters in passwords:  $  "  '  \  #  (space)

# Name or IP people type in the browser, e.g. monitoring.example.local or 10.20.30.40
SERVER_NAME=localhost

# --- ObservaOne UI logins (the main UI at https://SERVER/) ---
UI_BRAND=ObservaOne
UI_ADMIN_USER=admin
UI_ADMIN_PASSWORD=Change-Me-UiAdmin-123!
UI_OPERATOR_USER=operator
UI_OPERATOR_PASSWORD=Change-Me-UiOper-123!
UI_VIEWER_USER=viewer
UI_VIEWER_PASSWORD=Change-Me-UiView-123!
# Sign out after this many idle minutes / after this many hours in total
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8

# Password for the UI's PostgreSQL database (only the UI container uses it)
DB_PASSWORD=Change-Me-Database-123!
# Keep the audit log this many days
AUDIT_RETENTION_DAYS=365

# --- Grafana logins (https://SERVER/grafana/) ---
# Admin: full control (users, data sources, settings)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=Change-Me-Admin-123!
# Operator: can edit dashboards and silence alerts
GRAFANA_OPERATOR_USER=operator
GRAFANA_OPERATOR_PASSWORD=Change-Me-Operator-123!
# Viewer: read-only (managers, auditors)
GRAFANA_VIEWER_USER=viewer
GRAFANA_VIEWER_PASSWORD=Change-Me-Viewer-123!

# --- Login for the Prometheus and Alertmanager pages (admins only) ---
WEB_ADMIN_USER=promadmin
WEB_ADMIN_PASSWORD=Change-Me-Prom-123!

# --- Login that servers use to PUSH logs and traces (Grafana Alloy / OpenTelemetry Collector) ---
INGEST_USER=shipper
INGEST_PASSWORD=Change-Me-Ingest-Long-Password-123!

# How long Prometheus keeps metrics
PROM_RETENTION=30d

# Ports on this machine (change if 80/443 are already used)
HTTPS_PORT=443
HTTP_PORT=80

# ======================================================================
# Sign-in options for the ObservaOne UI (all optional)
# Put JSON values in single quotes, like the examples.
# ======================================================================
# Public address of the UI (used for SSO redirect URLs). Default: https://SERVER_NAME
#PUBLIC_URL=https://monitor.example.local
# Key that encrypts two-factor secrets. Leave empty: one is generated and kept in the observa-data volume.
#APP_SECRET=

# --- Company SSO: any OpenID Connect provider (Entra ID, Okta, Keycloak, Auth0, ...) ---
# Redirect URL to register at the provider: https://SERVER_NAME/api/auth/oidc/callback
#OIDC_LABEL=Company SSO
#OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_SCOPES=openid profile email
#OIDC_GROUPS_CLAIM=groups
# group -> role, first match wins. Leave OIDC_DEFAULT_ROLE empty to refuse people in no listed group.
#OIDC_ROLE_MAP='{"monitoring-admins":"admin","monitoring-sre":"operator"}'
#OIDC_DEFAULT_ROLE=viewer

# --- Google ---  redirect URL: https://SERVER_NAME/api/auth/google/callback
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_ALLOWED_DOMAINS=example.com
#GOOGLE_ROLE_MAP='{"boss@example.com":"admin","@example.com":"viewer"}'

# --- GitHub / GitHub Enterprise ---  redirect URL: https://SERVER_NAME/api/auth/github/callback
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
#GITHUB_ALLOWED_ORGS=my-org
#GITHUB_ROLE_MAP='{"my-org/sre":"operator","my-org":"viewer"}'
#GITHUB_URL=https://github.com
#GITHUB_API_URL=https://api.github.com

# --- LDAP / Active Directory (users type their normal username and password) ---
#LDAP_URL=ldaps://dc01.example.local:636
#LDAP_BIND_DN=CN=svc-monitoring,OU=Service,DC=example,DC=local
#LDAP_BIND_PASSWORD=
#LDAP_BASE_DN=DC=example,DC=local
#LDAP_USER_FILTER=(|(sAMAccountName={{username}})(uid={{username}}))
#LDAP_ROLE_MAP='{"Monitoring-Admins":"admin","Monitoring-Operators":"operator","Monitoring-Viewers":"viewer"}'
#LDAP_DEFAULT_ROLE=
#LDAP_START_TLS=false

# --- ObservaOne Agent for this Docker host (optional: docker compose --profile agent up -d) ---
# Create the token in the UI: Agents -> Tokens -> New token
AGENT_TOKEN=
AGENT_HOST=docker-host
AGENT_ENV=lab
