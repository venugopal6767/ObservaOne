# Address of the central ObservaOne, as this machine reaches it
GATEWAY_UPSTREAM=https://observaone.example.com
# Settings > Gateways > Add gateway in the central ObservaOne (shown once)
GATEWAY_TOKEN=
# The centre uses a self-signed certificate? Put it in ./certs/central.crt and uncomment:
# GATEWAY_CA_FILE=/certs/central.crt
# Name agents use to reach THIS gateway (goes into its certificate)
SERVER_NAME=gateway.site.local
