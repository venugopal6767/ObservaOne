{
  "id": "mongodb",
  "title": "MongoDB",
  "description": "MongoDB metrics per instance (ObservaOne DB agent). Clone to customise.",
  "tags": [
    "system",
    "database"
  ],
  "variables": [
    {
      "name": "db_instance",
      "label": "Instance",
      "label_name": "db_instance",
      "match": "observaone_db_up{db_engine=\"mongodb\"}"
    }
  ],
  "panels": [
    {
      "title": "Status",
      "type": "stat",
      "query": "max(mongodb_up{db_instance=\"$db_instance\"})",
      "unit": "none",
      "legend": "",
      "w": 3
    },
    {
      "title": "Connections",
      "type": "stat",
      "query": "max(mongodb_connections{db_instance=\"$db_instance\"})",
      "unit": "none",
      "legend": "",
      "w": 3
    },
    {
      "title": "Operations / s",
      "type": "line",
      "query": "sum(rate(mongodb_op_counters_total{db_instance=\"$db_instance\"}[5m]))",
      "unit": "none",
      "legend": "",
      "w": 6
    }
  ]
}
