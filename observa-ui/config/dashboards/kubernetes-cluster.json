{
  "id": "kubernetes-cluster",
  "title": "Kubernetes Cluster",
  "description": "Nodes, pods, capacity and usage per cluster (kube-state-metrics, kubelet/cAdvisor, node_exporter)",
  "tags": ["system", "kubernetes"],
  "variables": [
    { "name": "cluster", "label": "Cluster", "label_name": "cluster", "match": "kube_node_info" }
  ],
  "panels": [
    { "title": "Nodes ready", "type": "stat", "unit": "none", "legend": "", "w": 3,
      "query": "sum(kube_node_status_condition{cluster=\"$cluster\",condition=\"Ready\",status=\"true\"})" },
    { "title": "Nodes not ready", "type": "stat", "unit": "none", "legend": "", "w": 3,
      "query": "sum(kube_node_status_condition{cluster=\"$cluster\",condition=\"Ready\",status!=\"true\"}) or vector(0)" },
    { "title": "Pods running", "type": "stat", "unit": "none", "legend": "", "w": 3,
      "query": "sum(kube_pod_status_phase{cluster=\"$cluster\",phase=\"Running\"})" },
    { "title": "Pods pending or failed", "type": "stat", "unit": "none", "legend": "", "w": 3,
      "query": "sum(kube_pod_status_phase{cluster=\"$cluster\",phase=~\"Pending|Failed|Unknown\"}) or vector(0)" },

    { "title": "CPU requested (% of allocatable)", "type": "gauge", "unit": "percent", "legend": "", "w": 3,
      "query": "100 * sum(kube_pod_container_resource_requests{cluster=\"$cluster\",resource=\"cpu\"}) / sum(kube_node_status_allocatable{cluster=\"$cluster\",resource=\"cpu\"})" },
    { "title": "Memory requested (% of allocatable)", "type": "gauge", "unit": "percent", "legend": "", "w": 3,
      "query": "100 * sum(kube_pod_container_resource_requests{cluster=\"$cluster\",resource=\"memory\"}) / sum(kube_node_status_allocatable{cluster=\"$cluster\",resource=\"memory\"})" },
    { "title": "Container restarts (1 h)", "type": "stat", "unit": "none", "legend": "", "w": 3,
      "query": "round(sum(increase(kube_pod_container_status_restarts_total{cluster=\"$cluster\"}[1h])))" },
    { "title": "Deployments not fully available", "type": "stat", "unit": "none", "legend": "", "w": 3,
      "query": "count(kube_deployment_status_replicas_unavailable{cluster=\"$cluster\"} > 0) or vector(0)" },

    { "title": "CPU used by namespace (cores)", "type": "area", "unit": "short", "legend": "{{namespace}}", "w": 6,
      "query": "sum by (namespace) (rate(container_cpu_usage_seconds_total{cluster=\"$cluster\",container!=\"\"}[5m]))" },
    { "title": "Memory used by namespace", "type": "area", "unit": "bytes", "legend": "{{namespace}}", "w": 6,
      "query": "sum by (namespace) (container_memory_working_set_bytes{cluster=\"$cluster\",container!=\"\"})" },

    { "title": "Node CPU used", "type": "line", "unit": "percent", "legend": "{{host}}", "w": 6,
      "query": "clamp(100 - avg by (host) (rate(node_cpu_seconds_total{cluster=\"$cluster\",mode=\"idle\"}[5m])) * 100, 0, 100)" },
    { "title": "Node memory used", "type": "line", "unit": "percent", "legend": "{{host}}", "w": 6,
      "query": "100 * (1 - node_memory_MemAvailable_bytes{cluster=\"$cluster\"} / node_memory_MemTotal_bytes{cluster=\"$cluster\"})" },

    { "title": "Pods by phase", "type": "bar", "unit": "none", "legend": "{{phase}}", "w": 4,
      "query": "sum by (phase) (kube_pod_status_phase{cluster=\"$cluster\"}) > 0" },
    { "title": "Pods per node", "type": "bar", "unit": "none", "legend": "{{node}}", "w": 4,
      "query": "sum by (node) (kube_pod_info{cluster=\"$cluster\"})" },
    { "title": "Network in/out (bytes/s)", "type": "line", "unit": "Bps", "legend": "{{direction}}", "w": 4,
      "query": "label_replace(sum(rate(container_network_receive_bytes_total{cluster=\"$cluster\"}[5m])), \"direction\", \"in\", \"\", \"\") or label_replace(sum(rate(container_network_transmit_bytes_total{cluster=\"$cluster\"}[5m])), \"direction\", \"out\", \"\", \"\")" },

    { "title": "Deployments missing replicas", "type": "table", "unit": "none", "legend": "{{namespace}}/{{deployment}}", "w": 6,
      "query": "kube_deployment_status_replicas_unavailable{cluster=\"$cluster\"} > 0" },
    { "title": "Nodes under pressure", "type": "table", "unit": "none", "legend": "{{node}} {{condition}}", "w": 6,
      "query": "kube_node_status_condition{cluster=\"$cluster\",condition=~\"MemoryPressure|DiskPressure|PIDPressure\",status=\"true\"} == 1" }
  ]
}
